---
import dayjs from 'dayjs';
import type { NodeArticle, MediaType } from '../interfaces/jsonInterfaces';
import BlogPostCard from './BlogPostCard.astro';

import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

const accessibilityBlogBaseUrl = 'https://sanna.a11y.ing/blog/accessibility/';
const getAccessibilityBlogArticleUrl = (path: string) => {
  const articleSlug = path.replace(/^\/+|\/+$/g, '');
  return `${accessibilityBlogBaseUrl}${articleSlug}/`;
};

const drupalBaseUrl = import.meta.env.PUBLIC_DRUPAL_URL;
const drupalArticles = await fetch(`${drupalBaseUrl}/blogs/node/article?sort=-created&page[limit]=3&filter[field_blog_category.id][value]=a4bd8146-d52f-471f-9c07-bff738f81a47&include=field_blog_listing_image.field_media_image&fields[file--file]=uri,url`);
const articles = await drupalArticles.json();
const posts: { title: string, path: string, created: string, image?: string, description?: string }[] = [];

if (articles) {
  const includedFiles = articles.included.filter((item: MediaType) => item.type === 'file--file');
  const includedMedia = articles.included.filter((item: MediaType) => item.type === 'media--image');

  articles.data.map((item: NodeArticle) => {
    let fileURL;
    const mediaID = item.relationships.field_blog_listing_image.data.id;

    if (mediaID) {
      const listedMedia = includedMedia.find((mediaItem: MediaType) => mediaItem.id === mediaID);

      if (listedMedia) {
        const fileID = listedMedia.relationships.field_media_image.data.id;
        const listingFile = includedFiles.find((fileItem: MediaType) => fileItem.id === fileID);
        fileURL = listingFile.attributes.uri.url;
      }
    }

    posts.push({
      title: item.attributes.title,
      path: item.attributes.path.alias,
      created: item.attributes.created,
      image: fileURL ?? undefined,
      description: item.attributes.field_meta_description,
    });
  });
}

const sectionTitle = lang === 'fi'
  ? 'Uusimmat saavutettavuusartikkelini'
  : 'Latest accessibility articles from my blog';
const sectionIntro = lang === 'fi'
  ? 'Nämä uusimmat kirjoitukset käsittelevät verkkosaavutettavuutta käytännön näkökulmasta. Ne täydentävät sivuston oppaita ajankohtaisilla esimerkeillä, havainnoilla ja neuvoilla.'
  : 'These recent posts expand on the site guides with practical accessibility examples, current observations, and hands-on advice from my own blog.';
---
<section aria-labelledby="a11y-blog-heading" class="w-full bg-slate-300 mt-12 pt-12 pb-12 px-4 dark:bg-slate-900">
  <h2 id="a11y-blog-heading" class="a11y-heading block max-w-xl mx-auto lg:max-w-4xl font-bold mb-8 mt-0 text-3xl md:text-4xl text-lt-gray dark:text-white">
    {sectionTitle}
  </h2>
  <div class="max-w-7xl mx-auto">
    <p class="text-xl bodytext max-w-xl mx-auto leading-relaxed lg:max-w-4xl text-lt-gray dark:text-dk-gray">
      {sectionIntro}
    </p>
    {/* eslint-disable-next-line jsx-a11y/no-redundant-roles */}
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-y-8 md:gap-8" role="list">
      {posts.map((node) => (
        <BlogPostCard
          title={node.title}
          url={getAccessibilityBlogArticleUrl(node.path)}
          date={node.created}
          formattedDate={dayjs(node.created).format('MMMM DD, YYYY')}
          imageSrc={node.image ? `https://drupal.ampere.corrupted.pw/${node.image}` : undefined}
          description={node.description}
        />
      ))}
    </ul>
  </div>
</section>
